      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8F1D0C23-F1F3-433C-B199-D8393313F2C3}"
          SQLTask:SqlStatementSource="UPDATE D&#xA;SET IsHoliday = 1&#xA;FROM DimDate D&#xA;INNER JOIN&#xA;(&#xA;    SELECT&#xA;        CAST(LEFT(HolidayDate, CHARINDEX('-', HolidayDate) - 1) AS INT) AS Dia,&#xA;&#xA;        CASE LOWER(SUBSTRING(HolidayDate, CHARINDEX('-', HolidayDate) + 1, 3))&#xA;            WHEN 'ene' THEN 1&#xA;            WHEN 'feb' THEN 2&#xA;            WHEN 'mar' THEN 3&#xA;            WHEN 'abr' THEN 4&#xA;            WHEN 'may' THEN 5&#xA;            WHEN 'jun' THEN 6&#xA;            WHEN 'jul' THEN 7&#xA;            WHEN 'ago' THEN 8&#xA;            WHEN 'sep' THEN 9&#xA;            WHEN 'oct' THEN 10&#xA;            WHEN 'nov' THEN 11&#xA;            WHEN 'dic' THEN 12&#xA;        END AS Mes&#xA;    FROM StageHoliday&#xA;) H&#xA;ON D.DayNumber = H.Dia&#xA;AND D.MonthNumber = H.Mes;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
