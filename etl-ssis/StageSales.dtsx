    <DTS:Executable
      DTS:refId="Package\Execute SQL Task - Actualizar descuentos"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{936BCE17-E680-4963-9035-F49B9C8C4575}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task - Actualizar descuentos"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C6122343-CD8D-4A28-BBF9-C1366DB57D33}"
          SQLTask:SqlStatementSource=";WITH Totales AS&#xA;(&#xA;    SELECT&#xA;        BillingID,&#xA;        SUM(Quantity * UnitPrice) AS TotalBilling&#xA;    FROM StageSales&#xA;    GROUP BY BillingID&#xA;)&#xA;&#xA;UPDATE ss&#xA;SET DiscountPercent = ISNULL(d.Percentage, 0)&#xA;FROM StageSales ss&#xA;INNER JOIN Totales t&#xA;    ON ss.BillingID = t.BillingID&#xA;OUTER APPLY&#xA;(&#xA;    SELECT TOP 1 Percentage&#xA;    FROM StageDiscounts sd&#xA;    WHERE&#xA;        sd.TotalBilling &lt;= t.TotalBilling&#xA;        AND sd.DateFrom &lt;= TRY_CONVERT(datetime, ss.SaleDate, 101)&#xA;        AND (sd.DateUntil IS NULL OR sd.DateUntil &gt;= TRY_CONVERT(datetime, ss.SaleDate, 101))&#xA;    ORDER BY sd.TotalBilling DESC&#xA;) d;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
